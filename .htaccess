# Keep this file valid on Apache 2.2, 2.4, and LiteSpeed.
# A parse error here takes the whole domain down (empty reply / 500).

# Harden the failure mode: when PHP fatals (e.g. a parse error in a file
# loaded on every request) it returns an empty 500 and the site looks dead.
# Serve a friendly static page instead of a blank screen. The target MUST be
# static — never point ErrorDocument at a PHP file, or a fatal inside it would
# recurse. error500.html is a real file, so the rewrite below leaves it alone.
ErrorDocument 500 /error500.html
ErrorDocument 502 /error500.html
ErrorDocument 503 /error500.html
ErrorDocument 504 /error500.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Hide data dirs. Do not block /tools — that is an application controller.
  RewriteRule ^(?:database|tests|runtime|python-services)/ - [F,L,NC]
  # Server-side state: the sqlite dev database and the application logs.
  RewriteRule ^application/(?:data|logs|cache)/ - [F,L,NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|png|jpe?g|svg|webp)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>
</IfModule>

<FilesMatch "^(\.?env|\.env\.example)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
# The deployment reference file is also shipped under the dotless name `env`
# (the front controller's fallback). Never serve it, or any other server-side
# config, as a static file.
<FilesMatch "^(env|config\.php|database\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
