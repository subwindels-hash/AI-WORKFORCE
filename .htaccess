# Keep this file valid on Apache 2.2, 2.4, and LiteSpeed.
# A parse error here takes the whole domain down (empty reply / 500).

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Hide data dirs. Do not block /tools — that is an application controller.
  RewriteRule ^(?:database|tests|runtime|python-services)/ - [F,L,NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

<FilesMatch "^(\.env|\.env\.example)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
