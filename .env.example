# Copy this file to .env in cPanel File Manager, then edit only these values.
CI_ENV=production
VP_BASE_URL=https://yourdomain.com/

VP_DB_DRIVER=mysqli
VP_DB_HOST=localhost
VP_DB_PORT=3306
VP_DB_NAME=CPANEL_DATABASE_NAME
VP_DB_USER=CPANEL_DATABASE_USER
VP_DB_PASS=REPLACE_WITH_DATABASE_PASSWORD

# Preserve these values when moving an existing installation.
# Set unique long values before first production deployment and keep a safe backup.
VP_ENCRYPTION_KEY=replace-with-existing-long-encryption-key
VP_AUTH_SECRET=replace-with-existing-long-authentication-secret

# ---- SEO settings ----------------------------------------------------------
VP_SITE_NAME=WINDELS AI WORKFORCE
VP_SITE_DESCRIPTION=Evidence-first AI intelligence for trading, sports, language learning, lottery research and lead discovery.
VP_SITE_KEYWORDS=AI intelligence,trading intelligence,lead discovery,sports intelligence,language learning,EuroMillions
VP_SITE_TITLE_SUFFIX= · AI Workforce
VP_ROBOTS=index,follow
# VP_OG_IMAGE=https://yourdomain.com/assets/images/ai_workforce-mark.png
VP_THEME_COLOR=#07090e

# ---- AI website assistant --------------------------------------------------
# Leave blank to use the safe built-in product guide. To enable a real
# OpenAI-compatible chat provider, configure the URL/key/model server-side.
# AI_CHAT_API_URL=https://api.openai.com/v1/chat/completions
# AI_CHAT_API_KEY=replace-with-server-only-key
# AI_CHAT_MODEL=replace-with-approved-model
# AI_CHAT_ENABLED=0

# cPanel File Manager must leave this directory writable (typically 0755 or 0775).
# Optional override. Leave commented to use the portable bundled path:
# VP_SESSION_PATH=/home/CPANEL_USER/public_html/runtime/sessions
VP_SESSION_COOKIE=ai_workforce_session
VP_COOKIE_SECURE=1

# ---- SMTP / outbound mail (cPanel) ----------------------------------------
# Use the mailbox you host on cPanel so the system can send (and receive) real
# mail. In cPanel: Email → Email Accounts → Create the mailbox, then find its
# host/port under "Connect Devices" or the mail client settings. Typical cPanel:
#   host=mail.yourdomain.com  port=587  crypto=tls   (port 465 uses crypto=ssl)
# The FROM address should match VP_SMTP_USER — many cPanel hosts reject spoofed
# senders, and SPF/DKIM is easiest when the sender is a mailbox on your own domain.
VP_SMTP_ENABLED=0
VP_SMTP_HOST=mail.yourdomain.com
VP_SMTP_PORT=587
VP_SMTP_CRYPTO=tls
VP_SMTP_USER=noreply@yourdomain.com
VP_SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
VP_SMTP_TIMEOUT=10
VP_MAIL_FROM=noreply@yourdomain.com
VP_MAIL_FROM_NAME=WINDELS AI WORKFORCE
VP_MAIL_REPLY_TO=noreply@yourdomain.com
VP_MAIL_TYPE=html

# ---- Contact page + contact-form email ------------------------------------
# Public-facing details shown on the Contact page. VP_CONTACT_EMAIL is also the
# mailbox that receives contact-form submissions when SMTP is enabled.
# The map uses OpenStreetMap (no API key required) centred on the coords below.
VP_CONTACT_EMAIL=noreply@yourdomain.com
VP_CONTACT_PHONE=+234 800 000 0000
VP_CONTACT_ADDRESS=Suite 10, Example Business Plaza
VP_CONTACT_CITY=Abuja, Nigeria
VP_CONTACT_LAT=9.05785
VP_CONTACT_LON=7.49508
VP_CONTACT_MAP_ZOOM=12

# Optional real provider credentials. Leave blank to keep that provider disabled.
GOOGLE_PLACES_API_KEY=
# Apollo.io B2B people/company enrichment for Lead Discovery. Register a key at
# https://apollo.io (Settings → API → API Keys). Leave blank to disable.
# Accepted env var names: APOLLO_IO_API_KEY / APOLLO_API_KEY
# APOLLO_IO_API_BASE=https://api.apollo.io (override for sandbox/proxy)
# APOLLO_API_KEY=

# ---- AI Workforce MT5 bridge (Phase 4) — deploy python-services/mt5-bridge first ----
# Read-only account/quote access needs URL + TOKEN + ENABLED=1.
# Order submission additionally needs TRADING_ENABLED=1 and a bridge that
# itself reports tradingEnabled=true on a DEMO account.
# AI_WORKFORCE_MT5_BRIDGE_URL=http://bridge-host:8787
# AI_WORKFORCE_MT5_BRIDGE_TOKEN=long-random-shared-secret
# AI_WORKFORCE_MT5_BRIDGE_ENABLED=1
# AI_WORKFORCE_MT5_TRADING_ENABLED=0
# AI_WORKFORCE_MT5_LIVE_ALLOWED=0

# ---- New provider scaffolds (all disabled by default) ---------------------
# Each licensed market-data adapter requires URL, ENABLED=1, LICENSE and a
# comma-separated symbol allow-list. The URL must expose the neutral contract
# documented in application/libraries/AIWorkforce/Providers/LicensedAssetMarketDataProvider.php.
# AI_WORKFORCE_STOCK_DATA_URL=https://licensed-feed.example/v1
# AI_WORKFORCE_STOCK_DATA_TOKEN=replace-with-feed-token
# AI_WORKFORCE_STOCK_DATA_LICENSE=provider-license-or-contract-id
# AI_WORKFORCE_STOCK_DATA_SYMBOLS=AAPL,MSFT,TSLA
# AI_WORKFORCE_STOCK_DATA_ENABLED=0
# AI_WORKFORCE_STOCK_DATA_DELAYED=1
# Repeat the same variables with ETF, FUTURES and OPTIONS in place of STOCK.
#
# Delayed public Yahoo Finance chart (allow-listed stocks/ETFs/futures).
# On by default. Not licensed and not used for live order routing.
# AI_WORKFORCE_YAHOO_CHART_ENABLED=1
# AI_WORKFORCE_YAHOO_CHART_URL=https://query1.finance.yahoo.com

# Alpaca Markets: crypto bars/trades are public (no key); US equities/ETFs
# activate automatically when both APCA-API-KEY-ID and APCA-API-SECRET-KEY
# are supplied (or when ALPACA_EQUITIES_ENABLED=1 is set). Priority 16.
# ALPACA_API_BASE=https://data.alpaca.markets
# ALPACA_API_KEY=replace-with-apca-key-id
# ALPACA_API_SECRET=replace-with-apca-secret-key
# ALPACA_ENABLED=1
# ALPACA_EQUITIES_ENABLED=0

# OANDA v20 forex REST. Requires a valid Bearer token (practice or live).
# When configured, OANDA takes priority over Frankfurter/ECB for FX bid/ask
# candles; Frankfurter remains as the daily-reference fallback.
# OANDA_API_BASE=https://api-fxpractice.oanda.com
# OANDA_API_KEY=replace-with-oanda-bearer-token
# OANDA_ACCOUNT_ID=optional-account-id

# Interactive Brokers Client Portal Web API gateway. This is a LOCAL service
# you run alongside TWS / IB Gateway (typically https://localhost:5000). It
# is NOT registered until IBKR_ENABLED=1 and a running authenticated gateway
# is detected. Cert validation is disabled ONLY for localhost.
# IBKR_API_BASE=https://localhost:5000
# IBKR_ENABLED=0

# Authorized EuroMillions source. The source must expose the neutral draws
# contract documented in OfficialLotteryProvider.php. A license/source ID is
# mandatory; missing/invalid draws are rejected by the central validator.
# WINDELS_LOTTERY_OFFICIAL_URL=https://authorized-lottery.example/v1
# WINDELS_LOTTERY_OFFICIAL_HEALTH_URL=https://authorized-lottery.example/health
# WINDELS_LOTTERY_OFFICIAL_TOKEN=replace-with-provider-token
# WINDELS_LOTTERY_OFFICIAL_LICENSE=provider-license-or-contract-id
# WINDELS_LOTTERY_OFFICIAL_SOURCE=authorized-provider-name
# WINDELS_LOTTERY_OFFICIAL_ENABLED=0
# WINDELS_LOTTERY_OFFICIAL_JACKPOT_URL=https://authorized-lottery.example/v1/jackpot

# ---- MT4, crypto-exchange and stock-broker connector scaffolds ------------
# All connectors use a provider-neutral bridge contract and are disabled by
# default. Never set TRADING_ENABLED until the adapter is contract-tested.
# For each connector, set URL, TOKEN, ENABLED and optionally TRADING_ENABLED.
# LIVE_ALLOWED remains 0 by default and is required for non-demo accounts.
#
# AI_WORKFORCE_MT4_BRIDGE_URL=https://mt4-adapter.example
# AI_WORKFORCE_MT4_BRIDGE_TOKEN=replace-with-adapter-token
# AI_WORKFORCE_MT4_BRIDGE_ENABLED=0
# AI_WORKFORCE_MT4_BRIDGE_TRADING_ENABLED=0
# AI_WORKFORCE_MT4_BRIDGE_LIVE_ALLOWED=0
#
# Connector prefixes: BINANCE_CONNECTOR, BYBIT_CONNECTOR, OKX_CONNECTOR,
# COINBASE_CONNECTOR, KRAKEN_CONNECTOR, IB_CONNECTOR, ALPACA_CONNECTOR,
# OANDA_CONNECTOR. Each follows the same _URL/_TOKEN/_ENABLED/
# _TRADING_ENABLED/_LIVE_ALLOWED pattern.

# ---- Standalone Lead Discovery platform -----------------------------------
# SEO values are read at Next.js build time for metadata, sitemap and robots.
# NEXT_PUBLIC_SITE_NAME=Scout Lead Intelligence
# NEXT_PUBLIC_SITE_TITLE=Scout Lead Intelligence
# NEXT_PUBLIC_SITE_DESCRIPTION=Discover, organize, and prioritize real business leads.
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# NEXT_PUBLIC_SITE_KEYWORDS=lead discovery,sales intelligence,business leads,lead pipeline
# NEXT_PUBLIC_OG_IMAGE=/images/scout-logo.png
# NEXT_PUBLIC_ROBOTS=index,follow
# PostgreSQL is the permanent source of truth; Redis is operational only.
# DATABASE_URL=postgres://lead_user:replace-me@localhost:5432/lead_discovery
# REDIS_URL=redis://localhost:6379
# LEAD_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# CORS_ORIGINS=http://localhost:3000
# HOST=0.0.0.0
# PORT=3001
# The Next.js server-side rewrite uses this URL. Browser code stays relative.
# LEAD_API_INTERNAL_URL=http://127.0.0.1:3001

# ---- Sessions (production default is CI3 'files'; the offline dev bridge
# ---- uses 'database' because its per-request instances cannot share files).
# AI_WORKFORCE_SESSION_DRIVER=files

# ---- Advanced: fallback aliases & module toggles (all optional) -----------
# Every AI_WORKFORCE_* name below is a FALLBACK: the VP_* name above wins when
# both are set. They exist so the same code runs on hosts that only allow one
# naming scheme. Uncomment only if you prefer the long names.
# AI_WORKFORCE_BASE_URL=https://yourdomain.com/
# AI_WORKFORCE_ENCRYPTION_KEY=replace-with-existing-long-encryption-key
# AI_WORKFORCE_COOKIE_SECURE=1
# AI_WORKFORCE_SESSION_PATH=/home/CPANEL_USER/public_html/runtime/sessions
# AI_WORKFORCE_DB_DRIVER=mysqli
# AI_WORKFORCE_DB_HOST=localhost
# AI_WORKFORCE_DB_PORT=3306
# AI_WORKFORCE_DB_NAME=CPANEL_DATABASE_NAME
# AI_WORKFORCE_DB_USER=CPANEL_DATABASE_USER
# AI_WORKFORCE_DB_PASS=REPLACE_WITH_DATABASE_PASSWORD
# Show database errors instead of a generic error page (leave off in production).
# AI_WORKFORCE_DB_DEBUG=0
# SQLite database file when AI_WORKFORCE_DB_DRIVER/VP_DB_DRIVER=sqlite
# (offline dev bridge only — production uses MySQL/MariaDB).
# AI_WORKFORCE_SQLITE_PATH=

# Generic SMTP fallbacks used only when the VP_SMTP_*/VP_MAIL_* values above
# are unset: SMTP_USERNAME (or SMTP_USER), SMTP_ENCRYPTION (or SMTP_CRYPTO),
# MAIL_FROM_ADDRESS (or MAIL_FROM). VP_* is preferred.
# Contact-form destination fallback when VP_CONTACT_EMAIL is unset:
# VP_CONTACT_TO=noreply@yourdomain.com
# Announcement bar text (empty hides the bar; VP_ANNOUNCEMENT wins):
# ANNOUNCEMENT=
# VP_ANNOUNCEMENT=

# ---- Operations toggles ----------------------------------------------------
# Force every external provider call to use the built-in simulated provider
# (safe demos/maintenance; no outbound market-data calls are attempted).
# While this is 1 the chart can never go LIVE — it shows the SIMULATION badge.
# After changing provider settings, verify with:
#   php index.php tools marketdata            (report)
#   php index.php tools marketdata --activate  (enable a saved keyless public feed)
# AI_WORKFORCE_DISABLE_REAL_PROVIDERS=0
# Allow the paper-trading engine to serve synthetic test data.
# AI_WORKFORCE_ALLOW_SYNTHETIC_PAPER=0
# Port for the simulated (demo) broker bridge marker. Default 8790.
# AI_WORKFORCE_SIM_BRIDGE_PORT=8790
# DANGER: expose the /tools maintenance controller over HTTP. CLI-only by
# default (schema install, tests, admin bootstrap). Never enable in production.
# AI_WORKFORCE_ALLOW_HTTP_TOOLS=0
# Dev/test only: run a subset of the built-in test suite.
# AI_WORKFORCE_TEST_FILTER=
# First super-admin credentials for CLI bootstrap
# (`php index.php tools bootstrap_admin`). Production never auto-creates admins.
# AI_WORKFORCE_BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
# AI_WORKFORCE_BOOTSTRAP_ADMIN_NAME=Platform Administrator
# AI_WORKFORCE_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password

# ---- Sports intelligence module (off by default) ---------------------------
# WINDELS_SPORTS_ENABLED=0
# Provider mode: SANDBOX (built-in simulated feed) or HTTP (licensed feed).
# WINDELS_SPORTS_MODE=SANDBOX
# SANDBOX mode additionally requires this flag before serving data.
# WINDELS_SPORTS_SANDBOX=0
# HTTP provider connection (only used when WINDELS_SPORTS_MODE=HTTP):
# WINDELS_SPORTS_HTTP_BASE_URL=https://licensed-sports-feed.example/v1
# WINDELS_SPORTS_HTTP_ID=http-provider
# WINDELS_SPORTS_HTTP_TOKEN=replace-with-provider-token
# WINDELS_SPORTS_HTTP_TIMEOUT=10

# ---- Lottery research sandbox (off by default) -----------------------------
# Serve built-in sandbox draws for EuroMillions research. The licensed
# official provider above is configured separately.
# WINDELS_LOTTERY_SANDBOX=0

# ---- Market-data provider endpoints (defaults pinned, override rarely) -----
# BINANCE_API_BASE=https://api.binance.com
# BYBIT_API_BASE=https://api.bybit.com
# OKX_API_BASE=https://www.okx.com
# COINBASE_API_BASE=https://api.exchange.coinbase.com
# KRAKEN_API_BASE=https://api.kraken.com
#
# Public market-data feeds for crypto are enabled by default and require NO
# API keys. Each exchange can be turned off individually (e.g. to remove a
# provider that is geo-blocked on your host) by setting its _ENABLED flag to 0.
# CRYPTO_EXCHANGES_ENABLED=1
# BINANCE_ENABLED=1
# BYBIT_ENABLED=1
# OKX_ENABLED=1
# COINBASE_ENABLED=1
# KRAKEN_ENABLED=1
# FRANKFURTER_API_BASE=https://api.frankfurter.dev
