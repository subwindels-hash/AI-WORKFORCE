# Copy this file to .env in cPanel File Manager, then edit only these values.
CI_ENV=production
VP_BASE_URL=https://yourdomain.com/

VP_DB_DRIVER=mysqli
VP_DB_HOST=localhost
VP_DB_PORT=3306
VP_DB_NAME=CPANEL_DATABASE_NAME
VP_DB_USER=CPANEL_DATABASE_USER
VP_DB_PASS=REPLACE_WITH_DATABASE_PASSWORD

# Preserve these values when moving an existing installation.
# Set unique long values before first production deployment and keep a safe backup.
VP_ENCRYPTION_KEY=replace-with-existing-long-encryption-key
VP_AUTH_SECRET=replace-with-existing-long-authentication-secret

# cPanel File Manager must leave this directory writable (typically 0755 or 0775).
VP_SESSION_PATH=/home/CPANEL_USER/public_html/runtime/sessions
VP_SESSION_COOKIE=aegis_session
VP_COOKIE_SECURE=1

# Optional real provider credentials. Leave blank to keep that provider disabled.
GOOGLE_PLACES_API_KEY=

# ---- AEGIS MT5 bridge (Phase 4) — deploy python-services/mt5-bridge first ----
# Read-only account/quote access needs URL + TOKEN + ENABLED=1.
# Order submission additionally needs TRADING_ENABLED=1 and a bridge that
# itself reports tradingEnabled=true on a DEMO account.
# AEGIS_MT5_BRIDGE_URL=http://bridge-host:8787
# AEGIS_MT5_BRIDGE_TOKEN=long-random-shared-secret
# AEGIS_MT5_BRIDGE_ENABLED=1
# AEGIS_MT5_TRADING_ENABLED=0
# AEGIS_MT5_LIVE_ALLOWED=0

# ---- New provider scaffolds (all disabled by default) ---------------------
# Each licensed market-data adapter requires URL, ENABLED=1, LICENSE and a
# comma-separated symbol allow-list. The URL must expose the neutral contract
# documented in application/libraries/Aegis/Providers/LicensedAssetMarketDataProvider.php.
# AEGIS_STOCK_DATA_URL=https://licensed-feed.example/v1
# AEGIS_STOCK_DATA_TOKEN=replace-with-feed-token
# AEGIS_STOCK_DATA_LICENSE=provider-license-or-contract-id
# AEGIS_STOCK_DATA_SYMBOLS=AAPL,MSFT,TSLA
# AEGIS_STOCK_DATA_ENABLED=0
# AEGIS_STOCK_DATA_DELAYED=1
# Repeat the same variables with ETF, FUTURES and OPTIONS in place of STOCK.

# Authorized EuroMillions source. The source must expose the neutral draws
# contract documented in OfficialLotteryProvider.php. A license/source ID is
# mandatory; missing/invalid draws are rejected by the central validator.
# WINDELS_LOTTERY_OFFICIAL_URL=https://authorized-lottery.example/v1
# WINDELS_LOTTERY_OFFICIAL_HEALTH_URL=https://authorized-lottery.example/health
# WINDELS_LOTTERY_OFFICIAL_TOKEN=replace-with-provider-token
# WINDELS_LOTTERY_OFFICIAL_LICENSE=provider-license-or-contract-id
# WINDELS_LOTTERY_OFFICIAL_SOURCE=authorized-provider-name
# WINDELS_LOTTERY_OFFICIAL_ENABLED=0
# WINDELS_LOTTERY_OFFICIAL_JACKPOT_URL=https://authorized-lottery.example/v1/jackpot

# ---- MT4, crypto-exchange and stock-broker connector scaffolds ------------
# All connectors use a provider-neutral bridge contract and are disabled by
# default. Never set TRADING_ENABLED until the adapter is contract-tested.
# For each connector, set URL, TOKEN, ENABLED and optionally TRADING_ENABLED.
# LIVE_ALLOWED remains 0 by default and is required for non-demo accounts.
#
# AEGIS_MT4_BRIDGE_URL=https://mt4-adapter.example
# AEGIS_MT4_BRIDGE_TOKEN=replace-with-adapter-token
# AEGIS_MT4_BRIDGE_ENABLED=0
# AEGIS_MT4_BRIDGE_TRADING_ENABLED=0
# AEGIS_MT4_BRIDGE_LIVE_ALLOWED=0
#
# Connector prefixes: BINANCE_CONNECTOR, BYBIT_CONNECTOR, OKX_CONNECTOR,
# COINBASE_CONNECTOR, KRAKEN_CONNECTOR, IB_CONNECTOR, ALPACA_CONNECTOR,
# OANDA_CONNECTOR. Each follows the same _URL/_TOKEN/_ENABLED/
# _TRADING_ENABLED/_LIVE_ALLOWED pattern.

# ---- Sessions (production default is CI3 'files'; the offline dev bridge
# ---- uses 'database' because its per-request instances cannot share files).
# AEGIS_SESSION_DRIVER=files
